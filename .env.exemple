# Copiez ce fichier : cp .env.exemple .env   puis changez les mots de passe
# .env n'est JAMAIS versionné. Mots de passe : lettres et chiffres uniquement.

# --- Réglages de la plateforme -------------------------------------------
GROUPE=8            # numéro de groupe, 1 à 8 -> réseau 192.168.(55+G).0/24
PORT_HOTE=8080     # port de VOTRE machine vers le répartiteur (changez-le si 8080 est déjà pris)
NB_APP=2            # nombre de serveurs applicatifs (2 à 9) : LA valeur à changer pour passer à l'échelle
WITH_LB2=0          # 1 = extension E1 (répartiteur redondant lb2 + IP virtuelle .5)
WITH_OBS=0          # 1 = extension E2 (supervision Prometheus + Grafana sur obs)

# --- Secrets (valeurs d'exemple, à remplacer dans .env) ------------------
POSTGRES_PASSWORD=changez_moi
REPLICATION_PASSWORD=changez_moi
APP_DB_PASSWORD=changez_moi
GRAFANA_PASSWORD=changez_moi
